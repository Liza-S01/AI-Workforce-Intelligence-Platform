        "# Day 2: 09 - Model Versioning\n",
        "\n",
        "Verify serialized artifacts in `models/v1/` and metadata logging.\n"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "import json\n",
        "with open(\"../models/v1/metadata.json\") as f:\n",
        "    meta = json.load(f)\n",
        "print(\"Active Model Metadata:\")\n",
        "print(json.dumps(meta, indent=2))\n"
      ]
    }
